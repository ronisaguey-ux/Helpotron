{
  "manifest_version": 3,
  "name": "Helpotron Universal Automator",
  "version": "2.0.0",
  "description": "Universal educational assignment scraper, lecture recorder, and AI subagent across Canvas, Google Classroom, Blackboard, Moodle, and any arbitrary webpage.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "microphone"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "http://*.instructure.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}