{
  "manifest_version": 3,
  "name": "Helpotron Automator",
  "version": "1.0.0",
  "description": "Track your Canvas assignments and record lectures for study tools.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "microphone"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "*://canvas.*.edu/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.instructure.com/*", "*://canvas.*.edu/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
