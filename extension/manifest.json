{
  "manifest_version": 3,
  "name": "Helpotron Academic OS Companion",
  "version": "2.0.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "helpotron-companion@ronisaguey-ux.dev",
      "strict_min_version": "121.0"
    }
  },
  "description": "Autonomous Canvas LMS, Google Classroom, Blackboard & Moodle study companion and assignment solver.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://classroom.google.com/*",
    "https://*.blackboard.com/*",
    "https://*.brightspace.com/*",
    "https://*.d2l.com/*",
    "https://*.moodle.com/*",
    "https://*.schoology.com/*",
    "https://docs.google.com/*",
    "https://*.notion.so/*",
    "https://*.notion.site/*",
    "https://helpotron.dpdns.org/*",
    "http://localhost/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://classroom.google.com/*",
        "https://*.blackboard.com/*",
        "https://*.brightspace.com/*",
        "https://*.d2l.com/*",
        "https://*.moodle.com/*",
        "https://*.schoology.com/*",
        "https://docs.google.com/*",
        "https://*.notion.so/*",
        "https://*.notion.site/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
