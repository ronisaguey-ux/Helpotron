{
  "durations": {
    "fast": "120ms",
    "medium": "180ms",
    "standard": "240ms"
  },
  "easings": {
    "ease-out": "cubic-bezier(0, 0, 0.2, 1)",
    "emphasized": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "interactions": [
    {
      "name": "Sidebar Active Slide",
      "selector": ".nav-item.active::after",
      "transition": "transform 240ms cubic-bezier(0.2, 0, 0, 1), opacity 180ms",
      "reduced-motion": "opacity only"
    },
    {
      "name": "Button Press Scale",
      "selector": "button:active",
      "transition": "transform 120ms ease-out",
      "transform": "scale(0.98)",
      "reduced-motion": "none"
    },
    {
      "name": "Card Hover Lift",
      "selector": ".card-hover",
      "transition": "transform 180ms ease-out, box-shadow 180ms",
      "hover": "translate-y-[-4px] shadow-lg",
      "reduced-motion": "border-color change only"
    }
  ]
}