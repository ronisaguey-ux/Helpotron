[Unit]
Description=Automated atomic backup of Helpotron SQLite database
After=network.target

[Service]
Type=oneshot
User=roni
Group=roni
WorkingDirectory=/home/roni/helpotron
EnvironmentFile=-/home/roni/helpotron/.env
ExecStart=/home/roni/helpotron/scripts/backup_db.sh
StandardOutput=journal
StandardError=journal
Nice=10

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/roni/helpotron/backups /home/roni/helpotron/data /tmp
PrivateTmp=true
