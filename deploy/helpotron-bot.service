[Unit]
Description=Helpotron Telegram Bot Daemon
After=network.target helpotron-api.service

[Service]
Type=simple
User=helpotron
Group=helpotron
WorkingDirectory=/home/helpotron/helpotron
ExecStart=/home/helpotron/helpotron/.venv/bin/python -m server.telegram_bot
Restart=always
RestartSec=5
EnvironmentFile=/home/helpotron/helpotron/.env

# Systemd Security Sandboxing Flags
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/helpotron/helpotron
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
