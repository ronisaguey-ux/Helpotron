[Unit]
Description=Helpotron Telegram Notification Bot Service
After=network.target helpotron-api.service

[Service]
User=spark
Group=spark
WorkingDirectory=/var/www/helpotron
Environment="PATH=/var/www/helpotron/venv/bin"
EnvironmentFile=/var/www/helpotron/.env
ExecStart=/var/www/helpotron/venv/bin/python -m server.telegram_bot
Restart=always
RestartSec=10

NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
