[Unit]
Description=Helpotron Automator FastAPI Backend Daemon
After=network.target

[Service]
User=spark
Group=spark
WorkingDirectory=/var/www/helpotron
Environment="PATH=/var/www/helpotron/venv/bin"
EnvironmentFile=/var/www/helpotron/.env
ExecStart=/var/www/helpotron/venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=5

# Systemd Security Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/www/helpotron/data /tmp/helpotron_sandboxes
PrivateTmp=true

[Install]
WantedBy=multi-user.target
