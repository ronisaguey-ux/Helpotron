[Unit]
Description=Helpotron Automator Core API Server
After=network.target

[Service]
Type=simple
User=helpotron
Group=helpotron
WorkingDirectory=/home/helpotron/helpotron
ExecStart=/home/helpotron/helpotron/.venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8000 --workers 4 --proxy-headers
Restart=always
RestartSec=3
EnvironmentFile=/home/helpotron/helpotron/.env
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
