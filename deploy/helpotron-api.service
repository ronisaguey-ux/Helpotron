[Unit]
Description=Helpotron API + web (uvicorn)
After=network-online.target
Wants=network-online.target
Conflicts=helpotron-maintenance.service

[Service]
Type=simple
User=roni
Group=roni
WorkingDirectory=/home/roni/helpotron
EnvironmentFile=/home/roni/helpotron/.env
ExecStart=/home/roni/helpotron/.venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 5000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5

# Resource limits
MemoryMax=2G
MemoryHigh=1.5G
TasksMax=1024

# Sandboxing & security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/roni/helpotron/data /home/roni/helpotron/uploads /home/roni/helpotron/data_lake /home/roni/helpotron/datalake_storage
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
