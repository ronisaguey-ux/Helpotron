# Helpotron Automator — Environment Variables

# LLM
OMNIROUTE_API_BASE=http://localhost:20128/api/v1
OMNIROUTE_API_KEY=your-omniroute-key
PRIMARY_MODEL=deepseek-v4-flash

# Database
DATABASE_URL=sqlite:///helpotron.db

# Web
WEB_ORIGIN=http://localhost:5173

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin — set this to your public_id to access admin panel
ADMIN_PUBLIC_ID=RoniDev

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Security
SESSION_SECRET=your-session-secret-32-characters-min
PRODUCTION_MODE=false

# AI Content Detectors (Pangram, Sapling, Originality.ai, Copyleaks, Winston AI)
PANGRAM_API_KEY=your_pangram_api_key_here
SAPLING_API_KEY=your_sapling_api_key_here
ORIGINALITY_API_KEY=your_originality_ai_key_here
COPYLEAKS_API_KEY=your_copyleaks_api_key_here
COPYLEAKS_EMAIL=your_copyleaks_email_here
WINSTON_API_KEY=your_winston_ai_key_here

# User Verification & 2FA Secrets
JWT_SECRET=your_jwt_secret_32_characters_minimum
TOTP_SECRET=your_base32_totp_secret_key

# Email Verification & Email 2FA (SMTP: Gmail, SendGrid, Mailgun, Amazon SES)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_app_specific_password_here
EMAIL_FROM=noreply@helpotron.com
EMAIL_USE_TLS=true

# SMS 2FA (Twilio - Optional backup method)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12345678901

# Feature Toggles
ENABLE_EMAIL_VERIFICATION=false
ENABLE_2FA=true
ENABLE_SMS_2FA=true
ENABLE_TOTP_2FA=true


