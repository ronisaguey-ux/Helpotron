# ==============================================================================
# Helpotron Platform Environment Configuration
# Copy this file to .env and provide your secret API keys
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server & Web Origin
# ------------------------------------------------------------------------------
PORT=8000
WEB_ORIGIN=http://localhost:5173
PRODUCTION_MODE=false
ADMIN_PUBLIC_ID=RoniDev

# ------------------------------------------------------------------------------
# Primary LLMs & Model Tiering (Google Gemini & DeepSeek)
# ------------------------------------------------------------------------------
# Gemini 3.1 Flash-Lite: Cheap tier ($0.50/1M tokens) for transcription, OCR, summaries
# Gemini 3.7 Flash: Flagship tier ($2.50/1M tokens) for high effort & humanization
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_LITE_MODEL=gemini-3.1-flash-lite
GEMINI_FLASH_MODEL=gemini-3.7-flash

# DeepSeek & OpenAI fallbacks
PRIMARY_MODEL=deepseek-v4-flash
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OmniRoute Proxy (Optional Local LLM Proxy Gateway)
OMNIROUTE_API_BASE=http://localhost:20128/api/v1
OMNIROUTE_API_KEY=

# ------------------------------------------------------------------------------
# Audio Transcription & Whisper
# ------------------------------------------------------------------------------
# Used for lecture audio transcription fallback if Gemini is offline
WHISPER_API_KEY=your_whisper_api_key_here

# ------------------------------------------------------------------------------
# AI Detector Integrity Suite (Multi-Engine Verification)
# ------------------------------------------------------------------------------
PANGRAM_API_KEY=your_pangram_api_key_here
SAPLING_API_KEY=your_sapling_api_key_here
ORIGINALITY_API_KEY=your_originality_api_key_here
COPYLEAKS_API_KEY=your_copyleaks_api_key_here
COPYLEAKS_EMAIL=your_copyleaks_email_here
WINSTON_API_KEY=your_winston_api_key_here

# ------------------------------------------------------------------------------
# Payment Gateways (Stripe & PayPal)
# ------------------------------------------------------------------------------
STRIPE_API_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_SECRET=your_paypal_secret_here

# ------------------------------------------------------------------------------
# Telegram Alerts & Inter-Agent Coordination
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# Data Lake & Storage Paths
# ------------------------------------------------------------------------------
DATA_LAKE_DIR=./datalake_storage
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# Security, Sessions & 2FA
# ------------------------------------------------------------------------------
SESSION_SECRET=helpotron_super_secret_session_key_min_32_characters
JWT_SECRET=helpotron_super_secret_jwt_signing_key_min_32_chars
TOTP_SECRET=JBSWY3DPEHPK3PXP

# ------------------------------------------------------------------------------
# Email & SMS 2FA Delivery (Optional)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@helpotron.com
EMAIL_USE_TLS=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
