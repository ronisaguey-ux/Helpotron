# ==============================================================================
# Helpotron Platform Environment Configuration
# Copy this file to .env and provide your secret API keys
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server & Web Origin
# ------------------------------------------------------------------------------
PORT=8000
WEB_ORIGIN=http://localhost:5173
PRODUCTION_MODE=false
ADMIN_PUBLIC_ID=RoniDev
ADMIN_PASSWORD=change_me_to_a_secure_admin_password
DATABASE_URL=sqlite:///./helpotron.db
# For PostgreSQL in Docker or Cloud:
# DATABASE_URL=postgresql+psycopg2://helpotron:helpotron_secure_pg_pass_2026@postgres:5432/helpotron

# ------------------------------------------------------------------------------
# Primary LLMs & Model Tiering (Google Gemini & DeepSeek)
# ------------------------------------------------------------------------------
# Gemini 3.1 Flash-Lite: Cheap tier ($0.50/1M tokens) for transcription, OCR, summaries
# Gemini 3.8 Flash: Flagship tier ($2.50/1M tokens) for high effort & humanization
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_LITE_MODEL=gemini-3.1-flash-lite
GEMINI_FLASH_MODEL=gemini-3.8-flash

# DeepSeek & OpenAI fallbacks
PRIMARY_MODEL=deepseek-v4.1-flash
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OmniRoute Proxy (Optional Local LLM Proxy Gateway)
OMNIROUTE_API_BASE=http://localhost:20128/api/v1
OMNIROUTE_API_KEY=

# OpenRouter is the sole LLM/audio upstream. All model tiers, Gemini audio,
# and vision paths use this key with base https://openrouter.ai/api/v1.
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# Audio Transcription (via OpenRouter Gemini audio — no Whisper key needed)
# ------------------------------------------------------------------------------
# Transcription now defaults to Gemini audio through OpenRouter.
# WHISPER_API_KEY is no longer required or used.

# ------------------------------------------------------------------------------
# AI Detector Integrity Suite (Multi-Engine Verification)
# ------------------------------------------------------------------------------
PANGRAM_API_KEY=your_pangram_api_key_here
SAPLING_API_KEY=your_sapling_api_key_here
# Copyleaks and Originality.ai are intentionally NOT fetched (owner 08-26).
# Leave these empty; they are hidden/disabled in the UI and marked unavailable.
ORIGINALITY_API_KEY=
COPYLEAKS_API_KEY=
COPYLEAKS_EMAIL=
WINSTON_API_KEY=your_winston_api_key_here

# Self-hosted detectors (owner 09-06) — free, in-process, no API keys.
# ZipPy is always on when HELPOTRON_DETECTOR_ZIPPY is unset/true. The ONNX
# RoBERTa classifier serves only when the model dir is populated (run
# scripts/fetch_detector_model.sh; ~126 MB download). HELPOTRON_DETECTOR_FUNNEL
# makes a CLEAR local verdict (<=15 or >=90 of 100) skip the paid detectors.
# HELPOTRON_DETECTOR_ZIPPY=true
# HELPOTRON_DETECTOR_FUNNEL=true
# HELPOTRON_DETECTOR_MODEL_DIR=server/detector_models/onnx

# ------------------------------------------------------------------------------
# Payment Gateways (Stripe & PayPal)
# ------------------------------------------------------------------------------
STRIPE_API_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_SECRET=your_paypal_secret_here

# ------------------------------------------------------------------------------
# Telegram Alerts & Inter-Agent Coordination
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# Data Lake & Storage Paths
# ------------------------------------------------------------------------------
DATA_LAKE_DIR=./datalake_storage
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# Security, Sessions & 2FA
# ------------------------------------------------------------------------------
SESSION_SECRET=change_me_to_a_random_secure_32_character_session_key
JWT_SECRET=change_me_to_a_random_secure_32_character_jwt_key
TOTP_SECRET=change_me_to_a_random_base32_totp_secret

# ------------------------------------------------------------------------------
# Email & SMS 2FA Delivery (Optional)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=buisness@rs-systems-web.com
EMAIL_USE_TLS=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
# Twilio API key secret is not provided; SMS/2FA text features fail softly.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
