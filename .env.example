# ─── LLM (OmniRoute local proxy — OpenRouter-compatible) ────────────────────
# Primary: DeepSeek V4 Flash (free tier). Fallbacks rotate on failure.
OMNIROUTE_API_BASE=http://localhost:20128/api/v1
PRIMARY_MODEL=deepseek-v4-flash-free
FALLBACK_MODELS=mimo-v2.5-free,nemotron-3-ultra-free
# Only set if the proxy requires a key (local OmniRoute doesn't):
# OMNIROUTE_API_KEY=

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite for local dev; swap to postgresql://... for Supabase/PostgreSQL
DATABASE_URL=sqlite:///./helpotron.db

# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ─── Transcription ──────────────────────────────────────────────────────────
# If empty, tries local faster-whisper; if that's absent, /api/transcribe
# returns a clear error instead of silently failing.
WHISPER_API_KEY=

# ─── Payments ───────────────────────────────────────────────────────────────
# Stripe is real-SDK when STRIPE_SECRET_KEY is set; CashApp/Zelle/Venmo/PayPal
# providers are manual-offline records until API access is configured.
STRIPE_SECRET_KEY=

# ─── Web ────────────────────────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:5173
