# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# remediation scratch files (gemini verification scripts)
_*.py
verify_*.py

# secrets + local runtime state — MUST never be committed
# (executor commits via `git add -A`, which sweeps untracked files)
.env
.env.bak*
*.db
*.db-shm
*.db-wal
*.db.bak*
backups/
server.log
*.log
# rotated access/error logs (server/access_log.py) — *.log above misses the
# numbered backups access.log.1 … access.log.10
data/logs/*.log.*
data_lake/
web/dist/
web/node_modules/
.claude/skills/
pipeline/state/

# runtime uploads (avatars, agent memory, agent files) — never commit user data
uploads/
mcp/.env
.agents/*.json
.agents/mcp_config.json
.agents/skills/
shots/*.zip
exports/sandboxes/
.superdesign
.superdesign/tmp/
graphify-out/
helpotron_audit/
data/logs/
data/sandboxes/

