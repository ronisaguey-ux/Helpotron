# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# remediation scratch files (gemini verification scripts)
_*.py
# Root-anchored: this used to be `verify_*.py`, which also swallowed
# scripts/verify_extension.py — the harness that gates every extension release.
# An unreviewed harness is how its blind spots went unnoticed. Scratch files at
# the repo root stay ignored; scripts/ is reviewed like any other source.
/verify_*.py

# secrets + local runtime state — MUST never be committed
# (executor commits via `git add -A`, which sweeps untracked files)
.env
.env.bak*
*.db
*.db-shm
*.db-wal
*.db.bak*
backups/
server.log
*.log
# rotated access/error logs (server/access_log.py) — *.log above misses the
# numbered backups access.log.1 … access.log.10
data/logs/*.log.*
data_lake/
web/dist/
web/node_modules/
.claude/skills/
pipeline/state/

# runtime uploads (avatars, agent memory, agent files) — never commit user data
uploads/
mcp/.env
.agents/*.json
.agents/mcp_config.json
.agents/skills/
shots/*.zip
exports/sandboxes/
.superdesign
.superdesign/tmp/
graphify-out/
helpotron_audit/
data/logs/
data/sandboxes/


# playwright-mcp screenshot staging (QA evidence, not source)
.playwright-mcp/

# runtime log rotation artifacts (winston-daily-rotate-file)
logs/

# CWS upload packages (build artifacts)
/helpotron-extension-v*.zip

# fetched ONNX detector binaries (~126 MB) — fetch via scripts/fetch_detector_model.sh
server/detector_models/onnx/

# mock test-account session token (created by the verification harness) — never commit
verify-artifacts/_mock-account.json

# unpacked extension build outputs — regenerated by scripts/package_extension.sh.
# Tracking these caused BUG 0 (2026-09-07): the output dir name is derived from
# the manifest version, so a version change silently forked the build into a new
# directory while Chrome kept loading the old, tracked one.
/helpotron-extension-v*-test/
